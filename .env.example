# Public Supabase project configuration. These values identify the project but are not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Do not prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only abuse-prevention salt. Generate a unique random value per environment.
RATE_LIMIT_SALT=

# Optional server-only rate-limit tuning. Defaults are 5 attempts per 15 minutes.
ASSESSMENT_RATE_LIMIT_MAX_ATTEMPTS=5
ASSESSMENT_RATE_LIMIT_WINDOW_MINUTES=15

# Retention target is configurable and subject to privacy/legal review.
LEAD_DATA_RETENTION_MONTHS=24

# Public site configuration.
NEXT_PUBLIC_SITE_URL=https://linfytech.co.za
